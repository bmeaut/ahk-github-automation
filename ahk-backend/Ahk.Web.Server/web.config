<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<system.web>
		<customErrors mode="Off" />
	</system.web>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
       <handlers>
<remove name="aspNetCore"/>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModule" resourceType="Unspecified"/>
      </handlers>
      <!-- shutdownTimeLimit: ANCM's default of 10 seconds silently truncates the host's own 30-second
           shutdown, which would cut the webhook delivery worker off mid-delivery on every deploy and every
           app-pool recycle. Such a delivery is recorded as Interrupted and waits for a human, so giving it
           room to finish cleanly is worth the wait. -->
      <aspNetCore processPath=".\Ahk.Web.Server.exe" stdoutLogEnabled="true" stdoutLogFile="..\logs\stdout" hostingModel="inprocess" shutdownTimeLimit="30" />
    </system.webServer>
  </location>
</configuration>
