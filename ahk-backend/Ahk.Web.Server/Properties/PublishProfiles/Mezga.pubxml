<?xml version="1.0" encoding="utf-8"?>
<!--
Self-contained FileSystem publish for the Mezga IIS server, which has no .NET 10 runtime installed.
RuntimeIdentifier is required whenever SelfContained is true. Consumed by the deploy workflow via
-p:PublishProfile=Mezga so the publish parametrisation lives here, not in the pipeline.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <_IsPortable>true</_IsPortable>
    <PublishDir>bin\Release\net10.0\publish\</PublishDir>
  </PropertyGroup>
</Project>
